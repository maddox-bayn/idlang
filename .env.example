# Idlang environment variables — copy to .env and fill in.
# Nothing here is secret except HF_TOKEN. .env and .env.production are gitignored.

# ===========================================================================
# THE IMPORTANT ONE
# ===========================================================================
# The translation model. Stock NLLB-200 has NO Idoma token (idu_Latn resolves to
# <unk>) — with it, the service reports a configuration error for Idoma instead of
# quietly returning English.
#
# The trained checkpoint below was produced by training/train_idoma_nllb.ipynb and
# is verified: idu_Latn = 256204 (not <unk>=3), embeddings resized to 256205,
# generation_config.forced_bos_token_id = 256204, public and ungated.
NMT_MODEL_ID=emoduh/nllb-eng-idoma

# Target language token. Only change this if your checkpoint uses another code.
IDOMA_LANG_CODE=idu_Latn

# Escape hatch: emit Igbo (ibo_Latn) with a warning instead of erroring when the
# checkpoint has no Idoma token. Off by default — Igbo is not Idoma.
ALLOW_IGBO_FALLBACK=false

# Only needed for gated/private Hugging Face repos. Keep out of git.
# HF_TOKEN=hf_...

# ===========================================================================
# Frontend (build time — Vite inlines VITE_* into the bundle)
# ===========================================================================
# Where the browser should send /api/* requests.
#   - Split deploy (Vercel frontend + hosted backend): the backend's public URL.
#   - Single container serving both: set to an empty string for same-origin.
#   - Unset: same-origin in a production build, http://localhost:8080 in dev.
VITE_API_URL=http://localhost:8080

# ===========================================================================
# Go backend
# ===========================================================================
PORT=8080
TRANSLATOR_URL=http://localhost:5005

# Whether an exact dictionary hit short-circuits the model. The code default is
# `true`, but the bundled backend/idoma_dictionary_v2.json is fabricated — `òdò` is
# given as black, red, morning AND night; `Ófé` as both "Please" and "Thank you";
# `bird` is the placeholder `ụụ`. Left at `true`, those answers are served *ahead of*
# the trained model, so a working checkpoint still returns wrong Idoma for any word
# the file happens to contain, and it looks like the fine-tune failed.
#
# `false` makes the model authoritative. Set DICTIONARY_PATH to a dictionary you
# trust and flip this back to `true` if you want exact hits to stay exact.
DICTIONARY_FIRST=false
DICTIONARY_PATH=idoma_dictionary_v2.json

# ===========================================================================
# Python translator service
# ===========================================================================
# "cuda", "cpu", or unset to autodetect. Do not force cuda without a GPU.
# DEVICE=
CACHE_DIR=./model_cache

# Browser origins allowed to call the translator service directly, comma
# separated. Leave as * for local dev; set your real origin in production.
#   CORS_ORIGINS=https://idlang.vercel.app
CORS_ORIGINS=*
