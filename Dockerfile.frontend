# ==========================================
# Combined image: Vite frontend + FastAPI translator
# Used for single-container deploys (e.g. Hugging Face Spaces on :7860).
# Build from the repository root:  docker build -f Dockerfile.frontend -t idlang .
# ==========================================

# ==========================================
# STAGE 1: Build the Node frontend assets
# ==========================================
FROM node:20-alpine AS frontend-builder
WORKDIR /app

# Vite inlines VITE_* variables into the bundle at BUILD time, so this has to be
# a build argument — passing it as a runtime env var to the final image does
# nothing. Empty default = same-origin, which is what the single-container deploy
# below needs, since FastAPI serves both the assets and /api/* here.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ==========================================
# STAGE 2: Final Production environment
# ==========================================
FROM python:3.11-slim
WORKDIR /app

# Install system audio dependencies (required by Wav2Vec2/VITS)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Requirements live under translator_service/, not the repo root.
COPY translator_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the python server files
COPY translator_service/ ./

# Copy the compiled production frontend from Stage 1. backup_backend.py mounts
# ./dist at the root path when the directory is present.
COPY --from=frontend-builder /app/dist ./dist

# Hugging Face Spaces requires port 7860
EXPOSE 7860

ENV PORT=7860 \
    HOST=0.0.0.0 \
    CACHE_DIR=/app/model_cache

# Shell form so $PORT is honoured — a literal `--port 7860` overrides the variable,
# which breaks any host that assigns the port itself (Render, Fly). 7860 stays the
# default because that is what Spaces expects.
CMD ["sh", "-c", "exec uvicorn backup_backend:app --host \"${HOST:-0.0.0.0}\" --port \"${PORT:-7860}\""]
